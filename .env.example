# Local settings live in .env.local (git-ignored). `neon link` writes the three Neon variables
# for you; add the others by hand. Used by `npm run db:migrate` and by the pipeline
# (`cd pipeline && uv run --env-file ../.env.local unnati ...`).

# Postgres (Neon). Pooled URL for the website; direct URL for migrations and the pipeline.
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
NEON_BRANCH=production
# Read-only role used by the website.
DATABASE_URL_READONLY=postgresql://unnati_web:password@host/dbname?sslmode=require

# Free key from data.gov.in (sign in, then My Account). Needed for live AQI.
DATA_GOV_IN_API_KEY=

# The site's cache-refresh endpoint and the shared secret the pipeline sends to it.
REVALIDATE_URL=https://your-site.vercel.app/api/revalidate
REVALIDATE_SECRET=

# Cloudflare R2 (raw source archive, backups, public downloads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unnati-index
